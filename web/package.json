{
  "name": "pieqi-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:layout": "playwright test --project=layout",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:interaction": "playwright test --project=interaction",
    "test:e2e:online": "node e2e/run-online.mjs",
    "test:e2e:impact": "node e2e/impact.mjs",
    "test:e2e:update-baseline": "node e2e/update-baseline.mjs",
    "test:e2e:update-snapshots": "playwright test --project=visual --update-snapshots",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:vision": "node e2e/vision.mjs --batch"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
